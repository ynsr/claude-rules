{
  "name": "claude-rules-for-omp",
  "version": "0.1.0",
  "description": "Inject Claude Code .claude/rules/*.md rules and nested AGENTS.md into omp/Pi / DSH based on paths frontmatter",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dsh": "./src/dsh/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "build:omp": "bun build src/index.ts --target=bun --external:@earendil-works/pi-coding-agent --minify --outfile=claude-rules-for-omp.ts",
    "build:dsh": "bun build src/dsh/plugin.ts --target=bun --external:@deepseek-ai/cordis --external:@deepseek-ai/dsh-llm --minify --outfile=dsh-rules.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}